{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "jsdoc", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist/**", "dist-electron/**", "release/**", "node_modules/**", "src/renderer/public/**"],
  "overrides": [
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
